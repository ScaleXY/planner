{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "planner",
  "main": "src/index.ts",
  "account_id": "98f0ecdd86a00f1677266b31bd313769",
  "compatibility_date": "2026-10-25",
  "workers_dev": false,
  "preview_urls": false,
  // Custom Domain: the Worker is the origin for plans.athul.dev and serves both the index pages and the
  // plan files (from the PLANS binding).
  "routes": [{ "pattern": "plans.athul.dev", "custom_domain": true }],
  "r2_buckets": [{ "binding": "PLANS", "bucket_name": "plans" }]
}
